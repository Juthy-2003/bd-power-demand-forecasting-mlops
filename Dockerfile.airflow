# Airflow 3 with the pipeline installed in its OWN virtualenv
# (/opt/powerfc-venv). DAG tasks use @task.external_python to run there, so
# pandas 3 / MLflow 3 / Evidently never fight Airflow's pinned dependencies.
FROM apache/airflow:3.3.2-python3.12
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/powerfc-venv /opt/powerfc && chown -R airflow: /opt/powerfc-venv /opt/powerfc
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
USER airflow
WORKDIR /opt/powerfc
COPY --chown=airflow pyproject.toml uv.lock .python-version ./
COPY --chown=airflow src ./src
RUN UV_PROJECT_ENVIRONMENT=/opt/powerfc-venv uv sync --frozen --no-dev --python /usr/local/bin/python \
    && /opt/powerfc-venv/bin/python -c "import powerfc, lightgbm, mlflow"
ENV POWERFC_HOME=/opt/powerfc POWERFC_DATA=/opt/powerfc/data MLFLOW_DISABLE_AGENT_HINT=1
WORKDIR /opt/airflow
